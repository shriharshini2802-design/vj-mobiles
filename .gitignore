# =============================================
# VJ MOBILES - .gitignore
# =============================================

# Supabase config (contains API keys)
config.js

# SQL files (contains DB schema — keep private)
*.sql

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor folders
.vscode/
.idea/

# Logs
*.log

# Temp / zip files
*.zip
*.bak

# Node (if ever added)
node_modules/
.env
.env.local
.env.production
